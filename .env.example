# Ops/resolver wallet — real file lives at ~/.secrets/verdict.env, never commit real values here.
EVM_ADDRESS=
EVM_PRIVATE_KEY=

# 1Claw — real value lives at ~/.secrets/verdict.env (ONE_CLAW_API_KEY). The key that was in
# ~/.secrets/1claw.env was stale/revoked as of 2026-09-29 — see docs/DAY-ONE-FINDINGS.md §8.
ONE_CLAW_API_KEY=

# Dedicated Shroud-enabled agent for real LLM extraction (server/oracle-compiler), created by
# scripts/setup-shroud-agent.ts — real values live at ~/.secrets/verdict.env. See
# docs/DAY-ONE-FINDINGS.md §17.
ONE_CLAW_EXTRACTION_AGENT_ID=
ONE_CLAW_EXTRACTION_AGENT_API_KEY=

# Generate fresh per deal with ImdClient.generateClientToken(); store under 1Claw vault path imd/orders/<deal>
IMD_TOKEN=

RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com

# dRPC key — real value lives at ~/.secrets/verdict.env. Public RPCs (mainnet.base.org, etc.) are
# not reliable from a serverless deploy — confirmed the hard way, see docs/DAY-ONE-FINDINGS.md §18.
DRPC_API_KEY=

# Shared secret the deployed resolver webhook (site/app/api/resolve/[address]) checks against the
# X-Resolver-Secret header — real value lives at ~/.secrets/verdict.env. See §18.
RESOLVER_WEBHOOK_SECRET=

# Real deal storage (site/lib/deals.ts, site/lib/supabase.ts) — real values live at
# ~/.secrets/verdict.env. Project Settings → API in the Supabase dashboard. Service role key only —
# never the anon key, and never exposed client-side. See docs/DAY-ONE-FINDINGS.md §21.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Routes the resolve webhook's payment signature AND on-chain writes through 1Claw's Intents API
# instead of EVM_PRIVATE_KEY — no private key in this process at all. Preferred over EVM_PRIVATE_KEY
# when all three are set (site/app/api/resolve/[address]/route.ts). ADDRESS is the signing key's own
# address (OneClawClient.createSigningKey's return value), not derivable from the other two. Payment
# signing (§20) and transaction signing (§22) both work for real. 1Claw's own on-chain broadcast fails
# (§22's addendum: signs correctly, returns a tx_hash, never actually delivers), but the route uses
# oneClawSignAndBroadcastRelay, which signs via 1Claw and broadcasts the raw tx itself over a plain RPC
# — proven live on Base mainnet (§22's second addendum). Activated on the live deployment 2026-09-29
# (reusing the verdict-extraction agent — see §22's third addendum), making it a standing endpoint able
# to spend real $IMD/gas on any future trigger — set these only with the same deliberateness.
ONE_CLAW_RESOLVER_AGENT_ID=
ONE_CLAW_RESOLVER_AGENT_API_KEY=
ONE_CLAW_RESOLVER_ADDRESS=

# 1Claw Platform App for end-user embedded wallets (site/'s auth + wallet UI) — a different
# principal from ONE_CLAW_API_KEY/the agent keys above, which are for the resolver's own
# on-chain writes and LLM extraction, not end users. Real values live at
# ~/.secrets/verdict.env. See docs/designs/multi-tenant-1claw-wallets.md.
ONE_CLAW_PLATFORM_APP_ID=
ONE_CLAW_PLATFORM_APP_SLUG=
ONE_CLAW_PLATFORM_API_KEY=

# Client-side copies for site/'s embedded wallet widget (app/wallet/). The plt_ key is a
# publishable key by design — safe in a NEXT_PUBLIC_ var, unlike the 1ck_/ocv_ keys above.
# Same values as ONE_CLAW_PLATFORM_API_KEY/_APP_ID; set in site/.env.local for local dev.
NEXT_PUBLIC_ONECLAW_PLATFORM_KEY=
NEXT_PUBLIC_ONECLAW_PLATFORM_APP_ID=
