# Ops/resolver wallet — real file lives at ~/.secrets/verdict.env, never commit real values here.
EVM_ADDRESS=
EVM_PRIVATE_KEY=

# 1Claw — real value lives at ~/.secrets/verdict.env (ONE_CLAW_API_KEY). The key that was in
# ~/.secrets/1claw.env was stale/revoked as of 2026-09-29 — see docs/DAY-ONE-FINDINGS.md §8.
ONE_CLAW_API_KEY=

# Dedicated Shroud-enabled agent for real LLM extraction (server/oracle-compiler), created by
# scripts/setup-shroud-agent.ts — real values live at ~/.secrets/verdict.env. See
# docs/DAY-ONE-FINDINGS.md §17.
ONE_CLAW_EXTRACTION_AGENT_ID=
ONE_CLAW_EXTRACTION_AGENT_API_KEY=

# Generate fresh per deal with ImdClient.generateClientToken(); store under 1Claw vault path imd/orders/<deal>
IMD_TOKEN=

RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com

# dRPC key — real value lives at ~/.secrets/verdict.env. Public RPCs (mainnet.base.org, etc.) are
# not reliable from a serverless deploy — confirmed the hard way, see docs/DAY-ONE-FINDINGS.md §18.
DRPC_API_KEY=

# Shared secret the deployed resolver webhook (site/app/api/resolve/[address]) checks against the
# X-Resolver-Secret header — real value lives at ~/.secrets/verdict.env. See §18.
RESOLVER_WEBHOOK_SECRET=
